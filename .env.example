# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Groq API key (https://console.groq.com/keys). One key serves both:
#  - the official judge: upstream evaluator/judge.py ChatGroq reads API_KEY
#    (our scripts set JUDGE_BACKEND=groq; upstream's default backend is IBM-internal RITS)
#  - the agent: scripts/common.py copies it into OPENAI_API_KEY for the upstream
#    runner subprocess only, with OPENAI_BASE_URL=https://api.groq.com/openai/v1
API_KEY=gsk_your_groq_key_here

# Optional second agent backend: Google Gemini via its OpenAI-compatible endpoint
# (https://aistudio.google.com/apikey). Used only with `--agent-backend gemini`;
# the judge always stays on Groq gpt-oss-120b.
GEMINI_API_KEY=your_gemini_key_here

# Optional override (default shown).
# JUDGE_BACKEND=groq

# Hugging Face token: NOT needed for the public train split (scripts/download_data.py
# downloads anonymously). Only add one once VAKRA-GatedTest access is approved — upstream
# `make download` tries the gated test repo whenever a token is present.
# HF_TOKEN=hf_your_token_here
